@model LoanIndexViewModel


@{
    ViewData["Title"] = "Loans";
}


<h2>Loans</h2>


<p class="text-muted">Active</p>


<div class="tab-pane">
    <table class="table">
        <thead>
            <tr>
                <th>Tool</th>
                <th>Owner</th>
                <th>Borrower</th>
                <th>Loan Date</th>
                <th>Due Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var activeLoan in Model.ActiveLoans)
            {
                <tr>
                    <td><a asp-controller="Tools" asp-action="Details" asp-route-id="@activeLoan.ToolId">@activeLoan.ToolName</a></td>
                    <td>
                        <a asp-controller="Members" asp-action="Details" asp-route-id="@activeLoan.ToolOwnerId">
                            @activeLoan.ToolOwnerFullName
                        </a>
                    </td>
                    <td>
                        <a asp-controller="Members" asp-action="Details" asp-route-id="@activeLoan.ToolBorrowerId">
                            @activeLoan.ToolBorrowerFullName
                        </a>
                    </td>
                    <td>@activeLoan.LoanDate</td>
                    <td>@activeLoan.DueDate</td>
                    <td><span class="badge bg-warning">"Active"</span></td>
                    <td>
                        <form asp-action="Return" asp-route-id="@activeLoan.Id" method="post">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Mark Returned</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


