@model IEnumerable<MemberIndexViewModel>
@{
    ViewData["Title"] = "Member Directory";
}
<h2>Member Directory</h2>
<p class="text-muted">Everyone participating in the tool library</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Tools Owned</th>
            <th>Tools Shared</th>
            <th>Tools Borrowed</th>
            <th>Member Since</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@member.Id">
                        @member.FullName
                    </a>
                </td>
                <td>@member.Email</td>
                <td>@member.ToolsOwned</td>
                <td>@member.ToolsShared</td>
                <td>@member.ToolsBorrowed</td>
                <td>@member.MemberSince</td>
                <td>
                    <a class="btn btn-outline-secondary btn-sm"
                       asp-action="Details" asp-route-id="@member.Id">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>