@model MemberDetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2>
            Member: @Model.FullName
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model.MemberId">
                Edit
            </a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.MemberId">
                Delete
            </a>
        </h2>
        <p class="text-muted mb-0">Email: @Model.Email</p>
        <p class="text-muted small mb-0">Phone Number: @Model.PhoneNumber</p>

        <p class="text-muted small mb-0">Address: @(Model.Address ?? "none")</p>

        <p class="text-muted small">
            Member since @Model.MemberSince
        </p>
    </div>
    <a class="btn btn-success" asp-controller="Members" asp-action="AddTool" asp-route-id="@Model.MemberId">+ Add new Tool</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back to Directory</a>
</div>
<div class="row">
    <div class="col-md-6">
        <h5>Tools Owned (@Model.OwnedToolsCount)</h5>
        <table class="table table-sm">
            <thead><tr><th>Tool</th><th>Category</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var tool in Model.OwnedTools)
                {
                    <tr>
                        <td>
                            <a asp-controller="Tools" asp-action="Details" asp-route-id="@tool.ToolId">
                                @tool.ToolName
                            </a>
                        </td>
                        <td>@tool.CategoryName</td>
                        <td>
                            <span class="badge @(tool.IsAvailable ? "bg-success" : "bg-warning text-dark")">
                                @(tool.IsAvailable ? "Available" : "On Loan")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <div>
            <h5>Tools Shared (@Model.OpenLoansProvidedToolsCount)</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Tool</th>
                        <th>Loan Date</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.OpenLoansProvidedTools)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Tools" asp-action="Details" asp-route-id="@loan.ToolId">
                                    @loan.ToolName
                                </a>
                            </td>
                            <td>@loan.LoanDate</td>
                            <td>@loan.DueDate</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @loan.Status
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Members" asp-action="Details" asp-route-id="@loan.BorrowerId">
                                    @loan.BorrowerFullName
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        
        <div>
            <h5>Tools Borrowed (@Model.OpenLoansBorrowedToolsCount)</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Tool</th>
                        <th>Loan Date</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.OpenLoansBorrowedTools)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Tools" asp-action="Details" asp-route-id="@loan.ToolId">
                                    @loan.ToolName
                                </a>
                            </td>
                            <td>@loan.LoanDate</td>
                            <td>@loan.DueDate</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @loan.Status
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Members" asp-action="Details" asp-route-id="@loan.OwnerId">
                                    @loan.OwnerFullName
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>




<div class="row">

    <div class="col-md-6">
        <h5>Tools Shared History (@Model.ClosedLoansProvidedToolsCount)</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Tool</th>
                    <th>Loan Date</th>
                    <th>Due Date</th>
                    <th>Return Date</th>
                    <th>Status</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model.ClosedLoansProvidedTools)
                {
                    <tr>
                        <td>
                            <a asp-controller="Tools" asp-action="Details" asp-route-id="@loan.ToolId">
                                @loan.ToolName
                            </a>
                        </td>
                        <td>@loan.LoanDate</td>
                        <td>@loan.DueDate</td>
                        <td>@loan.ReturnDate</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @loan.Status
                            </span>
                        </td>
                        <td>
                            <a asp-controller="Members" asp-action="Details" asp-route-id="@loan.BorrowerId">
                                @loan.BorrowerFullName
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>




    <div class="col-md-6">
        <h5>Tools Borrowed History (@Model.ClosedLoansBorrowedToolsCount)</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Tool</th>
                    <th>Loan Date</th>
                    <th>Due Date</th>
                    <th>Return Date</th>
                    <th>Status</th>
                    <th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model.ClosedLoansBorrowedTools)
                {
                    <tr>
                        <td>
                            <a asp-controller="Tools" asp-action="Details" asp-route-id="@loan.ToolId">
                                @loan.ToolName
                            </a>
                        </td>
                        <td>@loan.LoanDate</td>
                        <td>@loan.DueDate</td>
                        <td>@loan.ReturnDate</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @loan.Status
                            </span>
                        </td>
                        <td>
                            <a asp-controller="Members" asp-action="Details" asp-route-id="@loan.OwnerId">
                                @loan.OwnerFullName
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
