@model MemberDetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2>
            Member: @Model.FullName
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </h2>
        <p class="text-muted mb-0">Email: @Model.Email</p>
        <p class="text-muted small mb-0">Phone Number: @Model.PhoneNumber</p>

        <p class="text-muted small mb-0">Address: @(Model.Address ?? "none")</p>

        <p class="text-muted small">
            Member since @Model.MemberSince
        </p>
    </div>
    <a class="btn btn-success" asp-controller="Members" asp-action="AddTool" asp-route-id="@Model.Id">+ Add new Tool</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back to Directory</a>
</div>
<div class="row">
    <div class="col-md-6">
        <h5>Tools Shared (@Model.OwnedToolsCount)</h5>
        <table class="table table-sm">
            <thead><tr><th>Tool</th><th>Category</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var tool in Model.OwnedTools)
                {
                    <tr>
                        <td>
                            <a asp-controller="Tools" asp-action="Details" asp-route-id="@tool.Id">
                                @tool.Name
                            </a>
                        </td>
                        <td>@tool.CategoryName</td>
                        <td>
                            <span class="badge @(tool.IsAvailable ? "bg-success" : "bg-warning text-dark")">
                                @(tool.IsAvailable ? "Available" : "On Loan")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <h5>Loan History (@Model.OpenLoansCount)</h5>
        <table class="table table-sm">
            <thead><tr><th>Tool</th><th>Due</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var loan in Model.OpenLoans)
                {
                    <tr>
                        <td>@loan.ToolName</td>
                        <td>@loan.DueDate</td>
                        <td>@loan.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>