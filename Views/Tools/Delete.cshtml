@model ToolDeleteViewModel


@{
    ViewData["Title"] = "Delete Tool";
}
<h2>Delete Tool</h2>
<p class="text-muted">This action cannot be undone</p>
<div class="alert alert-danger">
    <strong>⚠ Are you sure you want to delete this tool?</strong>
    <dl class="row mt-3 mb-0">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.CategoryName</dd>
        <dt class="col-sm-3">Owner</dt>
        <dd class="col-sm-9">@Model.OwnerFullName</dd>
        <dt class="col-sm-3">Active loans</dt>
        <dd class="col-sm-9">
            @(Model.ActiveLoans == 0 ? "None" : $"{Model.ActiveLoans} still on loan")
        </dd>
    </dl>
</div>


@if (Model.ActiveLoans > 0)
{
    <p class="text-danger small">
        This tool has @Model.ActiveLoans active loan(s).
    </p>
}
else
{
    <form asp-controller="Tools"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            Cancel
        </a>
    </form>
}





