@model ToolDeleteViewModel


@{
    ViewData["Title"] = "Delete Tool";
}
<h2>Delete Tool</h2>

<p class="text-muted">This action cannot be undone</p>
<div class="alert alert-danger">
    <strong>⚠ Are you sure you want to delete this tool?</strong>
    <dl class="row mt-3 mb-0">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.CategoryName</dd>
        <dt class="col-sm-3">Owner</dt>
        <dd class="col-sm-9">@Model.OwnerFullName</dd>
    </dl>
</div>


<form asp-controller="Tools"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>





