@model ToolDetailsViewModel


@{
    ViewData["Title"] = Model.Name;
}


<div class="row">
    <div class="col-md-6">
        <div class="bg-light text-center py-5 text-muted mb-2">
            @if (string.IsNullOrEmpty(Model.ImageUrl))
            {
                <span>[ tool photo ]</span>
            }
            else
            {
                <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.Name" />
            }
        </div>


    </div>
    <div class="col-md-6">
        <h2>@Model.Name</h2>
        <p class="text-muted">
            @Model.CategoryName · Listed by
            <a asp-controller="Members" asp-action="Details" asp-route-id="@Model.OwnerId">
                @Model.OwnerFullName
            </a>
        </p>
        <div class="border rounded p-3">
            <dl class="row mb-0">
                <dt class="col-sm-5">Condition</dt>
                <dd class="col-sm-7">@Model.Condition</dd>
                <dt class="col-sm-5">Replacement value</dt>
                <dd class="col-sm-7">@Model.ReplacementValue</dd>
                <dt class="col-sm-5">Status</dt>
                <dd class="col-sm-7">
                    <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-warning text-dark")">
                        @(Model.IsAvailable ? "Available" : "On Loan")
                    </span>
                </dd>
            </dl>
            <h6 class="mt-3">Description</h6>
            <p>@Model.Description</p>
            @if (Model.IsAvailable)
            {
                <a class="btn btn-success"
                   asp-controller="Loans" asp-action="Create" asp-route-toolId="@Model.Id">
                    Borrow this tool
                </a>
            }
            <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
            <a class="btn btn-outline-danger" asp-controller="Tools" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
        </div>
    </div>
</div>