@model DeleteViewModel


@{
    ViewData["Title"] = "Delete Member";
}

<h1 class="text-center">Delete Member</h1>

@if (Model.HasActiveLoans)
{
    <p class="text-muted">This member can't be deleted yet</p>

    <div class="alert alert-warning">
        <strong>&#9888; You still have open loans.</strong>

        <p class="mb-0 small mt-2">
            Close all open loans, before deleting this member.
        </p>
    </div>

    <a asp-controller="Users" asp-action="Dashboard" class="btn btn-outline-secondary">Back to Profile</a>
}
else
{
    <p class="text-muted">This action cannot be undone</p>
    <p class="text-muted">This action deletes the member and all associated data</p>


    <form asp-controller="Users" asp-action="DeleteConfirmed" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Users" asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
    </form>
}
