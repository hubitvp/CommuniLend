@model DetailsViewModel
@{
    ViewData["Title"] = Model.UserData.FullName;
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <partial name="_UserInfoPartial" model="@Model.UserData" />
    <a class="btn btn-success" asp-controller="Tools" asp-action="Add">+ Add new Tool</a>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Tools" asp-action="Index">Back to Tools</a>
</div>
<div class="row">
    <div class="col-md-6">

        <partial name="_OwnedToolsPartial" model="@Model" />

    </div>
    <div class="col-md-6">

        <partial name="_ProvidedToolsPartial" model="@Model" />


        <partial name="_BorrowedToolsPartial" model="@Model" />

    </div>
</div>



<div class="row">

    <div class="col-md-6">
        <partial name="_PastProvidedToolsPartial" model="@Model" />
    </div>


    <div class="col-md-6">
        <partial name="_PastBorrowedToolsPartial" model="@Model" />
    </div>
</div>
