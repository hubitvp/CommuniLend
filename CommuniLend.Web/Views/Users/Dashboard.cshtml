@model DetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2>
            Member: @Model.FullName
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model.UserId">
                Edit
            </a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.UserId">
                Delete
            </a>
        </h2>
        <p class="text-muted mb-0">Email: @Model.Email</p>
        <p class="text-muted small mb-0">Phone Number: @Model.PhoneNumber</p>

        <p class="text-muted small mb-0">Address: @(Model.Address ?? "none")</p>

        <p class="text-muted small">
            Member since @Model.MemberSince
        </p>
    </div>
    <a class="btn btn-success" asp-controller="Tools" asp-action="Add">+ Add new Tool</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back to Directory</a>
</div>
<div class="row">
    <div class="col-md-6">

        <partial name="_OwnedToolsPartial" model="@Model" />

    </div>
    <div class="col-md-6">

        <partial name="_ProvidedToolsPartial" model="@Model" />


        <partial name="_BorrowedToolsPartial" model="@Model" />

    </div>
</div>




<div class="row">

    <div class="col-md-6">
        <partial name="_PastProvidedToolsPartial" model="@Model" />
    </div>




    <div class="col-md-6">
        <partial name="_PastBorrowedToolsPartial" model="@Model" />
    </div>
</div>
