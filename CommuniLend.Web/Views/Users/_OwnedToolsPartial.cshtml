@using System.Security.Claims
@model DetailsViewModel

<div>
    <h5>Tools Owned (@Model.OwnedToolsCount)</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Tool</th>
                <th>Category</th>
                <th>Added On</th>
                <th>Status</th>


                @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.UserId)
                {
                    <th>Edit</th>
                    <th>Delete</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var tool in Model.OwnedTools)
            {
                <tr>
                    <td>
                        <a asp-controller="Tools" asp-action="Details" asp-route-id="@tool.ToolId">
                            @tool.ToolName
                        </a>
                    </td>
                    <td>@tool.CategoryName</td>
                    <td>@tool.AddedOn</td>
                    <td>
                        <partial name="_ToolStatusPartial" model="@tool.AvailabilityStatus" />
                    </td>


                    @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.UserId)
                    {
                        @if (tool.AvailabilityStatus == ToolAvailabilityStatus.Available)
                        {
                            <td>
                                <a class="btn btn-outline-warning" asp-controller="Tools" asp-action="Edit" asp-route-id="@tool.ToolId">
                                    Edit
                                </a>
                            </td>
                            <td>
                                <a class="btn btn-outline-danger" asp-controller="Tools" asp-action="DeleteDetails" asp-route-id="@tool.ToolId">
                                    Delete
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>
                                <span class="btn btn-outline-secondary pe-none">
                                    Edit
                                </span>
                            </td>
                            <td>
                                <span class="btn btn-outline-secondary pe-none">
                                    Delete
                                </span>
                            </td>
                        }
                    }

                </tr>
            }
        </tbody>
    </table>
</div>