@using System.Security.Claims
@model UserViewModel


<div>

    <h2>
        Member: @Model.FullName


        @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.UserId)
        {

            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model.UserId">
                Edit
            </a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.UserId">
                Delete
            </a>

        }


    </h2>
    <h5>
        Status:
        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
            @(Model.IsActive ? "Active" : "Inactive")
        </span>
    </h5>
    <p class="text-muted mb-0">Email: @Model.Email</p>
    <p class="text-muted small mb-0">Phone Number: @Model.PhoneNumber</p>

    <p class="text-muted small mb-0">Address: @(Model.Address ?? "none")</p>

    <p class="text-muted small">
        Member since @Model.MemberSince
    </p>
</div>