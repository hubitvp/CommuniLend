@model IEnumerable<BorrowedToolViewModel>

<div class="tab-pane">
    <table class="table">
        <thead>
            <tr>
                <th>Tool</th>
                <th>Owner</th>
                <th>Loan Date</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var activeLoan in Model)
            {
                <tr>
                    <td><a asp-controller="Tools" asp-action="Details" asp-route-id="@activeLoan.ToolId">@activeLoan.ToolName</a></td>
                    <td>
                        <a asp-controller="Users" asp-action="Details" asp-route-id="@activeLoan.ToolOwnerId">
                            @activeLoan.ToolOwnerFullName
                        </a>
                    </td>
                    <td>@activeLoan.LoanDate</td>
                    <td>@activeLoan.DueDate</td>
                    <td>
                        <partial name="_ToolStatusPartial" model="@activeLoan.AvailabilityStatus" />
                    </td>
                    <td>@activeLoan.Notes</td>
                </tr>
            }
        </tbody>
    </table>
</div>