@model IEnumerable<MemberIndexViewModel>
@{
    ViewData["Title"] = "Member Directory";
}



<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Member Directory</h2>
        <p class="text-muted mb-0">Everyone participating in the tool library</p>
    </div>
    <a class="btn btn-success" asp-action="AddMember">+ Add a Member</a>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Tools Owned</th>
            <th>Tools Shared</th>
            <th>Tools Borrowed</th>
            <th>Member Since</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@member.MemberId">
                        @member.FullName
                    </a>
                </td>
                <td>@member.Email</td>
                <td>@member.ToolsOwned</td>
                <td>@member.ToolsShared</td>
                <td>@member.ToolsBorrowed</td>
                <td>@member.MemberSince</td>
                <td>
                    <span class="badge @(member.IsActive ? "bg-success" : "bg-warning text-dark")">
                        @(member.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>
                    <a class="btn btn-outline-success" asp-action="Details" asp-route-id="@member.MemberId">
                        Details
                    </a>

                    <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@member.MemberId">
                        Edit
                    </a>

                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@member.MemberId">
                        Delete
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>