@model MemberDetailsViewModel


<div>
    <h5>Tools Borrowed (@Model.BorrowedToolsCount)</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Tool</th>
                <th>Loan Date</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Owner</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var borrowedTool in Model.BorrowedTools)
            {
                <tr>
                    <td>
                        <a asp-controller="Tools" asp-action="Details" asp-route-id="@borrowedTool.ToolId">
                            @borrowedTool.ToolName
                        </a>
                    </td>
                    <td>@borrowedTool.LoanDate</td>
                    <td>@borrowedTool.DueDate</td>
                    <td>
                        <partial name="_ToolStatusPartial" model="@borrowedTool.ToolStatus" />
                    </td>
                    <td>
                        <a asp-controller="Members" asp-action="Details" asp-route-id="@borrowedTool.OwnerId">
                            @borrowedTool.OwnerFullName
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>