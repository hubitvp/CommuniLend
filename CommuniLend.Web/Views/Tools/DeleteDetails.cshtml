@model DeleteViewModel


@{
    ViewData["Title"] = "Delete Tool";
}
<h2>Delete Tool</h2>

<p class="text-muted">This action cannot be undone</p>


<div class="row">
    <div class="col-md-6">
        <div class="bg-light text-center py-5 text-muted mb-2">

            <partial name="_ToolImgePartial" model="(@Model.ToolId, @Model.ToolName, @Model.ToolImageUrl)" />

        </div>
    </div>

    <div class="col-md-6">

        <div class="alert alert-danger">


            @if (Model.IsDeletable)
            {
                <strong>⚠ Are you sure you want to delete this tool?</strong>
            }
            else
            {
                <strong>⚠ This tool cannot be deleted because it is currently on loan.</strong>
            }

            <dl class="row mt-3 mb-0">


                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.ToolName</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.CategoryName</dd>


                <dt class="col-sm-3">Added On</dt>
                <dd class="col-sm-9">@Model.AddedOn</dd>

                <dt class="col-sm-3">Condition</dt>
                <dd class="col-sm-9">@Model.Condition</dd>

                <dt class="col-sm-3">Replacement Value</dt>
                <dd class="col-sm-9">@Model.ReplacementValue € EUR</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>


            @if (Model.IsDeletable)
            {
                <form asp-controller="Tools"
                      asp-action="DeleteConfirm"
                      asp-route-id="@Model.ToolId"
                      method="post">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-controller="Users" asp-action="Dashboard" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </form>
            }
            else
            {
                <a asp-action="Details" asp-route-id="@Model.ToolId" class="btn btn-outline-secondary">
                    Back to Details
                </a>
            }

        </div>

    </div>

</div>







