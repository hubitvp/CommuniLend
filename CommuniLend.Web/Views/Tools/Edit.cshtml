@model ToolFormInputViewModel
@{
    ViewData["Title"] = "Edit Tool";
}



<div class="row">
    <div class="col-md-6">
        <div class="bg-light text-center py-5 text-muted mb-2">
            <partial name="_ToolImgePartial" model="(@Model.ToolId, @Model.ToolName, @Model.ToolImageUrl)" />
        </div>
    </div>
    <div class="col-md-6">
        <h2>Edit Tool: @Model.ToolName</h2>

        <div class="border rounded p-3">

            <partial name="_ToolFormPartial" model="@Model" />
            <button type="submit"
                    form="9eac5554-7c06-4212-8dae-af5eaec761cf"
                    formaction="@Url.Action("Edit", "Tools")"
                    formmethod="post"
                    formenctype="multipart/form-data"
                    class="btn btn-warning">
                Save Changes
            </button>
            <a asp-controller="Users" asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
