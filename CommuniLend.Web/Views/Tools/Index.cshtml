@model IndexViewModel

@{
    ViewData["Title"] = "Tool Catalog";
}


<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Tool Catalog</h2>
        <p class="text-muted">Browse tools shared by your neighbors</p>
    </div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">

        <input type="text" name="search" value="@Model.SearchString"
               class="form-control" placeholder="Search tools (e.g. 'ladder', 'drill')" />
    </div>
    <div class="col-md-3">
        <select name="category" class="form-select"
                asp-items="@Model.Categories.Select(c => new SelectListItem
                {
                    Text = c.Name,
                    Value = c.Id.ToString(),
                    Selected = c.Id == Model.CategoryId
                })">
            <option value="">All categories</option>
        </select>

    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
    </div>
</form>
<div class="row">
    @foreach (var tool in Model.Tools)
    {
        <partial name="_ToolIndexItemPartial" model="@tool" />
    }
</div>


