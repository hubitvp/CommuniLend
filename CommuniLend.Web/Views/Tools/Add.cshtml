@model ToolFormInputViewModel

@{
    ViewData["Title"] = "Add a Tool";
}

<h2>Add new Tool</h2>

<partial name="_ToolFormPartial" model="@Model" />


<button type="submit"
        form="9eac5554-7c06-4212-8dae-af5eaec761cf"
        formaction="@Url.Action("Add", "Tools")"
        formmethod="post"
        formenctype="multipart/form-data"
        class="btn btn-success">
    Save Tool
</button>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}